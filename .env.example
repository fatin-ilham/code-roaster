# Copy this to .env and customize

# OpenRouter API Key
OPENROUTER_API_KEY=your_api_key_here

# AI Model to use (https://openrouter.ai/models)
MODEL=qwen/qwen-2.5-72b-instruct

# Flask settings
FLASK_ENV=production
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# Rate limiting (requests per minute per IP)
RATE_LIMIT=10

# Cache settings
CACHE_ENABLED=true
CACHE_DIR=.cache
